{
  "name": "hono-cqrs-prac",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/main.ts",
    "start": "bun run src/main.ts",
    "check:types": "tsc --noEmit",
    "check:lint": "oxlint -c .oxlintrc.jsonc",
    "check:updates": "pnpm outdated --recursive --long",
    "format:check": "oxfmt -c .oxfmtrc.jsonc --check",
    "format:fix": "oxfmt -c .oxfmtrc.jsonc",
    "lint:fix": "pnpm check:lint --fix && pnpm format:fix && pnpm check:types",
    "db:up": "docker compose up -d",
    "db:stop": "docker compose stop",
    "db:generate": "drizzle-kit generate --config ./src/shared/db/drizzle.config.ts",
    "db:migrate": "bun run src/shared/db/scripts/migrate.ts",
    "db:studio": "drizzle-kit studio --config ./src/shared/db/drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "postgres": "^3.4.9",
    "typescript": "^7.0.2"
  }
}
